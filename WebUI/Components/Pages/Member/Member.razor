    private async Task DeleteItem(MemberDto member)
    {
    
       
        if (member is null)
        {
            return;
        }

        IDialogReference dialog = await dialogService.ShowConfirmationAsync(
            $"Are you sure to delete '{member.FirstName} {member.LastName}'?",
            "Yes",
            "No",
            "Delete Member?");
        DialogResult result = await dialog.Result;

       
        if (result.Cancelled)
        {
            return;
        }

      
        try
        {
            
        }
        catch (Exception exc)
        {
            string errorMessage = exc.InnerException?.Message ?? exc.Message;
            await dialogService.ShowErrorAsync("Error", errorMessage);
        }
   
    }
    private void ShowItem(MemberDto memberDto)
    {

