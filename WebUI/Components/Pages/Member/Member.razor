    protected async Task RefreshItemsAsync(GridItemsProviderRequest<MemberDto> req)
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        var query = new GetMemberPaginationQuery
        {
            PageNumber = pagination.CurrentPageIndex,
			PageSize = pagination.ItemsPerPage
        };

        var result = await mediator.Send(query);

        members = result.AsQueryable();

		await pagination.SetTotalItemCountAsync(result.TotalCount);

		loading = false;
        await InvokeAsync(StateHasChanged);
    }
}